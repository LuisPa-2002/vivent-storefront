# Public HTTPS URL of the Vivent backend. Do not include a trailing slash.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Default tenant used on a Vercel deployment domain that is not a corpoviva.com subdomain.
NEXT_PUBLIC_DEFAULT_TENANT=demo

# Optional: required only to render the interactive delivery pin map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
